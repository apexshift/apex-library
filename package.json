{
  "name": "apex",
  "version": "0.0.0",
  "description": "Apex - High-performance vanilla JS library for text effects and more",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./String/Effects": "./dist/String/Effects/index.js",
    "./String/Effects/*": "./dist/String/Effects/*.js",
    "./String/Effects/YugopScramble": "./dist/String/Effects/YugopScramble.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "preview": "vite build && echo 'Build complete. check dist/ folder'",
    "lint": "eslint src",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write src",
    "changeset": "changeset",
    "version": "changesets version",
    "release": "changesets publish",
    "prepare": "husky",
    "size": "size-limit",
    "test": "vitest",
    "test:ci": "vitest --run"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "javascript",
    "vanilla-js",
    "text-effects",
    "animation"
  ],
  "author": "Aaron Smyth",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@size-limit/time": "^12.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "5 kb",
      "running": false
    },
    {
      "path": "dist/String/Effects/ScrambleEngine.js",
      "limit": "8 kb",
      "running": false
    }
  ]
}
