{
  "name": "apex",
  "version": "0.2.0",
  "description": "Apex - High-performance vanilla JS library for text effects and more",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./Core": "./dist/Core/index.js",
    "./DX": "./dist/DX/index.js",
    "./Event": "./dist/Event/index.js",
    "./Maths": "./dist/Maths/index.js",
    "./Performance": "./dist/Performance/index.js",
    "./String/Effects": "./dist/String/Effects/index.js",
    "./String/Effects/*": "./dist/String/Effects/*.js",
    "./String/Tickers": "./dist/String/Tickers/index.js",
    "./String/Tickers/*": "./dist/String/Tickers/*.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --project tsconfig.json",
    "preview": "vite build && echo 'Build complete. check dist/ folder'",
    "lint": "eslint src",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write src",
    "changeset": "changeset",
    "version": "changesets version",
    "release": "changesets publish",
    "prepare": "husky",
    "size": "size-limit",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:coverage": "vitest --run --coverage"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "javascript",
    "vanilla-js",
    "text-effects",
    "animation"
  ],
  "author": "Aaron Smyth",
  "license": "MIT",
  "packageManager": "pnpm@10.33.3+sha512.a19744364a7e248b92657a4ca5973f9354d21caf982579674b1c539f32c7420c47138ad8b1254df07aba9bc782d9b3029e3db34d5dbff974326eb74dac8ff489",
  "peerDependencies": {
    "gsap": ">=3.0.0",
    "lenis": ">=1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@size-limit/time": "^12.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "gsap": "^3.15.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lenis": "^1.3.23",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "5 kb",
      "running": false
    },
    {
      "path": "dist/String/Effects/ScrambleEngine.js",
      "limit": "8 kb",
      "running": false
    }
  ]
}
